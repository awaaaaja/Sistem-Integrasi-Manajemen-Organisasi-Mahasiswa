# Salin ke .env.local lalu isi nilai asli
# Semua kredensial Supabase: dashboard supabase (project xdyohbilfnlhtcrflgcm)
# Referensi kolom: SCHEMA.md §7

# --- Public (client) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<publishable-key>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Database (Drizzle, server-only) ---
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# --- Server secrets (jangan pernah masuk client bundle) ---
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ACCESS_TOKEN=sbp_<access-token>      # Supabase CLI (login/link)
SUPABASE_STORAGE_BUCKET=simormawa-files

# --- Auth (NextAuth v5) ---
AUTH_SECRET=<random-32bytes>                  # generate: npx auth secret
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000